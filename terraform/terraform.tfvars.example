region                 = "eu-central-1"
project_name           = "secure-platform"
github_org             = "momenckhouse-dev"
terraform_state_bucket = "your-tfstate-bucket"

# Lab mode: one NAT gateway and small nodes to keep the bill down.
# On the AWS Free plan only free-tier-eligible types launch; t3.large is rejected, m7i-flex.large works.
single_nat_gateway  = true
node_instance_types = ["m7i-flex.large"]

# Your public IP as /32 (the validation rejects 0.0.0.0/0) and the IAM user or role you run kubectl as.
cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]
cluster_admin_principal_arns         = ["arn:aws:iam::111122223333:user/your-admin-user"]

# Needed when GitHub issues immutable OIDC subjects (it did for this project).
# Find the IDs with: gh api repos/OWNER/REPO/actions/oidc/customization/sub, gh api users/OWNER --jq .id
# github_owner_id = "12345678"
# github_repo_ids = { "app-source" = "1000000001", "infra" = "1000000002" }
